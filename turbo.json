{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**",
        "src/generated/**"
      ]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "SCAN_WORKER_URL",
        "SCAN_WORKER_TOKEN",
        "SCAN_WORKER_HOST",
        "SCAN_WORKER_PORT",
        "SCAN_EGRESS_ALLOWLIST",
        "SCAN_CALLBACK_URL",
        "SCAN_CALLBACK_TOKEN",
        "DATABASE_URL",
        "LOG_LEVEL",
        "NODE_ENV"
      ]
    },
    "start": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "SCAN_WORKER_URL",
        "SCAN_WORKER_TOKEN",
        "SCAN_WORKER_HOST",
        "SCAN_WORKER_PORT",
        "SCAN_EGRESS_ALLOWLIST",
        "SCAN_CALLBACK_URL",
        "SCAN_CALLBACK_TOKEN",
        "DATABASE_URL",
        "LOG_LEVEL",
        "NODE_ENV"
      ]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "format": {
      "cache": false
    },
    "check-types": {
      "dependsOn": ["^build", "^check-types"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"],
      "passThroughEnv": [
        "SCAN_WORKER_URL",
        "SCAN_WORKER_TOKEN",
        "SCAN_WORKER_HOST",
        "SCAN_WORKER_PORT",
        "SCAN_EGRESS_ALLOWLIST",
        "SCAN_CALLBACK_URL",
        "SCAN_CALLBACK_TOKEN",
        "DATABASE_URL",
        "DOCKER_HOST",
        "TESTCONTAINERS_*",
        "LOG_LEVEL",
        "NODE_ENV"
      ]
    },
    "test:e2e": {
      "dependsOn": ["^build"],
      "cache": false,
      "passThroughEnv": [
        "E2E_WEB_PORT",
        "E2E_WORKER_PORT",
        "E2E_FIXTURES_PORT",
        "E2E_CLOSED_PORT",
        "E2E_SCAN_WORKER_TOKEN",
        "DOCKER_HOST",
        "TESTCONTAINERS_*",
        "CI"
      ]
    }
  }
}
