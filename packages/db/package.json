{
  "name": "@refresh/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "dist",
    "prisma",
    "prisma.config.ts"
  ],
  "scripts": {
    "generate": "prisma generate",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "dev": "prisma generate && tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "check-types": "prisma generate && tsc --noEmit",
    "lint": "biome check",
    "format": "biome format --write",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "test": "prisma generate && vitest run --coverage",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@prisma/adapter-pg": "catalog:",
    "@prisma/client": "catalog:",
    "@refresh/scan-contracts": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@refresh/config": "workspace:*",
    "@testcontainers/postgresql": "catalog:",
    "testcontainers": "catalog:",
    "@types/node": "^22",
    "@vitest/coverage-v8": "catalog:",
    "prisma": "catalog:",
    "typescript": "^5",
    "ultracite": "catalog:",
    "vitest": "catalog:"
  }
}
