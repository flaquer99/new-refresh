# Base URL of the scan worker (apps/scan-worker). Read at request time by the /api/scans Route Handlers.
SCAN_WORKER_URL=http://127.0.0.1:3001

# Shared bearer token for web -> worker requests. Required; at least 32 random characters.
# Must match SCAN_WORKER_TOKEN in apps/scan-worker. Generate one with: openssl rand -hex 32
SCAN_WORKER_TOKEN=

# Bearer token the worker sends to /api/internal/scans/<id>/result. Required; at least 32 random
# characters, different from SCAN_WORKER_TOKEN. Must match SCAN_CALLBACK_TOKEN in apps/scan-worker.
SCAN_CALLBACK_TOKEN=

# PostgreSQL that stores scans and reports. Start the local one with `pnpm db:up`, then `pnpm db:migrate`.
DATABASE_URL=postgresql://refresh:refresh@127.0.0.1:5432/refresh
