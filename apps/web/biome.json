{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"extends": ["@refresh/config/biome/next"],
	"files": {
		"includes": [
			"!node_modules",
			"!.next",
			"!dist",
			"!build",
			"!public",
			"!coverage",
			"!test-results",
			"!playwright-report",
			"!.vitest",
			"!.agents",
			"!skills-lock.json",
			"!.impeccable/hook.cache.json"
		]
	},
	"overrides": [
		{
			"includes": ["src/components/ui/**"],
			"assist": {
				"actions": {
					"source": {
						"organizeImports": "off"
					}
				}
			},
			"linter": {
				"rules": {
					"style": {
						"useImportType": "off"
					},
					"a11y": {
						"noLabelWithoutControl": "off",
						"useSemanticElements": "off"
					},
					"suspicious": {
						"noArrayIndexKey": "off",
						"noDoubleEquals": "off"
					}
				}
			}
		}
	]
}
