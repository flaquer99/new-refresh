# Shared bearer token for web -> worker requests. Required; at least 32 random characters.
# Must match SCAN_WORKER_TOKEN in apps/web. Generate one with: openssl rand -hex 32
SCAN_WORKER_TOKEN=

# Where the worker posts each scan's final result (web's internal callback route, without /<id>/result).
SCAN_CALLBACK_URL=http://127.0.0.1:3000/api/internal/scans

# Bearer token for worker -> web result callbacks. Required; at least 32 random characters,
# different from SCAN_WORKER_TOKEN. Must match SCAN_CALLBACK_TOKEN in apps/web.
SCAN_CALLBACK_TOKEN=

# Address the worker HTTP server binds to. Keep it on loopback unless a trusted proxy fronts it.
SCAN_WORKER_HOST=127.0.0.1
SCAN_WORKER_PORT=3001

# Tests only: comma-separated host:port entries the egress guard lets through even on private addresses.
# The worker refuses to start when this is set and NODE_ENV=production.
SCAN_EGRESS_ALLOWLIST=

# pino log level: fatal, error, warn, info, debug, or trace.
LOG_LEVEL=info
